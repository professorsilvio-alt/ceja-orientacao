# Copie este arquivo para .env e preencha com seus dados reais
SECRET_KEY=sua-chave-secreta-django-aqui
DEBUG=True

# Banco de dados (MySQL para PythonAnywhere / SQLite para dev local)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Para MySQL no PythonAnywhere, descomente e preencha:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=seunome$ceja_gestao
# DB_USER=seunome
# DB_PASSWORD=sua-senha-mysql
# DB_HOST=seunome.mysql.pythonanywhere-services.com
# DB_PORT=3306

# E-mail (Gmail com senha de app)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=email_da_escola@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=CEJA Profa Rosa Soares <email_da_escola@gmail.com>

# URL base do sistema (para links de recuperação de senha)
BASE_URL=http://127.0.0.1:8000
